# Database names follow agentstudio<env>, all lowercase: agentstudiodev for local work.
# See docs/database/database.md#databases. `bun run db:reset` and `db:bootstrap --reset` only drop
# names ending in dev, test or ci.
DATABASE_URL="postgresql://your-db-user:your-db-password@localhost:5432/agentstudiodev"
OPENROUTER_API_KEY="sk-or-v1-your-key"
# Creates the owner account the first time the server starts against a database with
# no owner (and is what `bun run db:bootstrap` uses). Never overwrites an existing
# password. Removed from the server's environment after boot. The placeholder below is
# refused — change it. Unset: open /setup instead (a production build then asks for a
# one-time setup token printed in the server log).
AUTH_PASSWORD="change-me"
# Optional, for the owner AUTH_PASSWORD creates. Defaults: "Owner" / "owner".
# AUTH_OWNER_NAME="Your Name"
# AUTH_OWNER_USERNAME="owner"
# Dev-only: when set to 1 AND NODE_ENV != 'production', requests without a session
# auto-attach to the owner (skips the /login redirect) — for driving the app from a
# viewer or agent that can't sign in. Attaches only once an owner with a password
# exists (`bun run db:bootstrap` creates one). Ignored by production builds
# (`bun run build`) whatever NODE_ENV says; never enable on a shared machine.
AUTH_DEV_BYPASS=0
SEARXNG_URL="http://192.168.0.2:8070"
SEARXNG_PASSWORD="change-me"
# Must be writable: each chat turn creates its workspace here before the agent starts.
# On a development machine without a writable /workspace, use a local folder, e.g. "./.sandbox".
SANDBOX_WORKSPACE="/workspace"
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
APP_ENCRYPTION_KEY="change-me-32-bytes-min"
GITHUB_OAUTH_CLIENT_ID="your-github-client-id"
GITHUB_OAUTH_CLIENT_SECRET="your-github-client-secret"
# Optional, off by default. An Anthropic-compatible gateway that lets chat run non-Claude
# models. Leave both unset and only Claude models are offered — they run on the Claude
# subscription at no per-token cost. Set both and the model pickers also list the gateway's
# models, labelled "Gateway · paid": every gateway turn is billed per token, and non-Claude
# models are less reliable at multi-step tool use. See docs/llm/llm.md.
# OpenRouter's Anthropic endpoint (the token is an OpenRouter API key):
# LLM_GATEWAY_URL="https://openrouter.ai/api"
# LLM_GATEWAY_TOKEN="sk-or-v1-your-key"
# Or a self-hosted LiteLLM proxy (pin a known-good version; never 1.82.7 or 1.82.8):
# LLM_GATEWAY_URL="http://your-litellm-host:4000"
# LLM_GATEWAY_TOKEN="your-litellm-master-key"
# Optional. Lets an external scheduler fire POST /api/cron with
# `Authorization: Bearer <value>` — only needed if the in-process scheduler is off
# (JOBS_SCHEDULER_ENABLED=0). Unset: only a signed-in session can fire the route.
# CRON_SECRET="a-long-random-string"
