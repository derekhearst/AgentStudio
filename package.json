{
  "name": "AgentStudio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "tauri:icons": "bunx tauri icon static/icon.svg -o src-tauri/icons",
    "android:build:local": "powershell -ExecutionPolicy Bypass -File scripts/android-build-local.ps1",
    "android:install:local": "powershell -ExecutionPolicy Bypass -File scripts/android-install-local.ps1",
    "android:run:local": "bun run android:build:local && bun run android:install:local",
    "dev": "vite dev",
    "dev:test": "bun run scripts/test-server.ts",
    "dev:test:nocreds": "bun run scripts/test-server.ts --no-credentials",
    "worker": "bun scripts/worker.ts",
    "build": "BUILD_PHASE=1 vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo && tsc -p scripts/tsconfig.json && tsc -p src/service-worker.tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
    "test:e2e": "playwright test",
    "test:no-mocks": "bun scripts/no-mocks-in-crud.ts",
    "test:crud": "playwright test tests/crud",
    "test": "bun run test:e2e",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check --dialect=postgresql --out=./drizzle",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:reset": "bun scripts/reset-and-bootstrap.ts",
    "db:bootstrap": "bun scripts/bootstrap-dev.ts",
    "bench:longmemeval:download": "bun run scripts/bench/longmemeval/download-data.ts",
    "bench:longmemeval:ingest": "bun --tsconfig-override=scripts/bench/tsconfig.json run scripts/bench/longmemeval/ingest.ts",
    "bench:longmemeval:retrieve": "bun --tsconfig-override=scripts/bench/tsconfig.json run scripts/bench/longmemeval/retrieve.ts",
    "bench:longmemeval:score-retrieval": "bun run scripts/bench/longmemeval/score-retrieval.ts",
    "bench:longmemeval:qa": "bun --tsconfig-override=scripts/bench/tsconfig.json run scripts/bench/longmemeval/qa.ts",
    "bench:longmemeval:score-qa": "bun --tsconfig-override=scripts/bench/tsconfig.json run scripts/bench/longmemeval/score-qa.ts",
    "bench:longmemeval:smoke": "bun --tsconfig-override=scripts/bench/tsconfig.json run scripts/bench/longmemeval/smoke.ts",
    "bench:longmemeval:reset": "bun --tsconfig-override=scripts/bench/tsconfig.json run scripts/bench/longmemeval/reset-memory-tables.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/web-push": "^3.6.4",
    "@typescript/native": "npm:typescript@7",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.278",
    "@mdi/font": "^7.4.47",
    "@node-rs/argon2": "^2.2.1",
    "@openrouter/sdk": "^0.11.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.5",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "daisyui": "^5.7.42",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.13",
    "marked-highlight": "^2.2.4",
    "playwright": "^1.63.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  }
}